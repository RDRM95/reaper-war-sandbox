{
  "name": "reaper-war-sandbox",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Spectator-only fleet combat powered by the original Reaper War simulation and rendering",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "benchmark:4k": "node scripts/benchmark_4k.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "@types/three": "^0.186.0",
    "@types/node": "^22.20.5",
    "@playwright/test": "~1.56.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
